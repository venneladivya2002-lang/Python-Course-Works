def countdown(n):
    while n>=0:
        yield n
        n=n-1
for num in countdown(3):
    print(num)


def nested_sum(lst):
    total=0
    for item in lst:
        if isinstance(item,list):
            total+=nested_sum(item)
        else:
            total+=item
    return total
print(nested_sum([1,[2,3],4]))
        
