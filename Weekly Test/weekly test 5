def reverse_number(n,rev=0):
    if n==0:                            #n//10 means removes the last digits like example(1234)
                                        #(1234,0)
        return rev                      #1234//10=123
    return reverse_number(n // 10,rev*10+n%10) #0*10+1234%10=4
