def is_prime(n,i=2):
    if n<=1:
        return False    # i value start with 2 or prime value start with 2
                        #example:i=2 2*2>7 false
                        #i=3 3*3=9>7:
                        # yes so 7 is a prime number
    if i*i>n:           # 7%3!=0
        return True
    if n%i==0:
        return False
    return is_prime(n,i+1)
print(is_prime(7))
print(is_prime(15))

